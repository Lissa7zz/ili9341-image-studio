{
  "name": "ili9341-image-studio",
  "version": "0.3.0",
  "private": true,
  "description": "Browser-based RGB565 image converter for STM32 and ILI9341 displays",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles msi,nsis",
    "test": "node tests/all.test.mjs",
    "test:e2e": "playwright test",
    "release:prepare": "node scripts/prepare-tauri-release.mjs"
  },
  "keywords": [
    "stm32",
    "ili9341",
    "rgb565",
    "image-converter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^31.0.0"
  }
}
