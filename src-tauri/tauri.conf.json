{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pixel2Panel",
  "version": "0.3.1",
  "identifier": "io.github.lissa7zz.pixel2panel",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pixel2Panel",
        "width": 1440,
        "height": 920,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ILI9341 RGB565 image converter for STM32",
    "longDescription": "Crop images, convert them to RGB565, and generate paired STM32 C source and header files. All image processing happens locally.",
    "homepage": "https://lissa7zz.github.io/ili9341-image-studio/",
    "copyright": "Copyright (C) 2026 Lissa7zz",
    "publisher": "Lissa7zz",
    "license": "MIT",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
